# App Configuration
APP_NAME="Havamania API"
APP_ENV=production
DEBUG=false
API_V1_PREFIX=/v1

# Security - REQUIRED in production
SECRET_KEY=generate-a-secure-random-key-here
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Database
DATABASE_URL=postgresql+psycopg://user:password@hostname:5432/dbname

# CORS - Comma separated list of origins
CORS_ORIGINS=https://app.havamania.app,https://admin.havamania.app

# External Services
WEATHER_PROVIDER=open_meteo
CHATBOT_BASE_URL=https://havamania.com/api/bridge
# Required server-only secret; supply from secret storage, never commit the actual key.
CHATBOT_API_KEY=
CHATBOT_TIMEOUT_SECONDS=50
CHATBOT_FREE_DAILY_LIMIT=10
CHATBOT_PREMIUM_DAILY_LIMIT=100

# Monitoring
SENTRY_DSN_BACKEND=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
# Enable only after migrations, Admin credentials, security rules and retry job are deployed.
ACCOUNT_DELETION_ENABLED=false

# Set only to approved, published consent text/version. Blank disables remote assistant calls.
# No default consent is assumed. Health consent is separate and optional.
# ASSISTANT_CONSENT_VERSION=2
ASSISTANT_CONSENT_TEXT=
# ASSISTANT_HEALTH_CONSENT_VERSION=2
ASSISTANT_HEALTH_CONSENT_TEXT=

# configured: approved local texts; platform: authenticated GET /consent, no stale fallback.
ASSISTANT_CONSENT_SOURCE=configured
