rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Admin-only marker prevents stale tokens from recreating deleted data.
    function activeOwner(userId) {
      return request.auth != null && request.auth.uid == userId
        && !exists(/databases/$(database)/documents/account_deletions/$(userId));
    }
    // User-scoped data isolation
    match /users/{userId} {
      // Allow user to read/write their own profile document
      allow read, write: if activeOwner(userId);

      // trips subcollection
      match /trips/{tripId} {
        allow read, write: if activeOwner(userId);
      }

      // cities subcollection (used for city search/favorites)
      match /cities/{cityId} {
        allow read, write: if activeOwner(userId);
      }

      // Recursive safety for any other user-scoped data
      match /{allPaths=**} {
        allow read, write: if activeOwner(userId);
      }
    }
  }
}
